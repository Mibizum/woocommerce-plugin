msgstr "Cela s'exécute en arrière-plan. Vous pouvez continuer à travailler ; pas besoin d'attendre ici."

#: templates/wizard.php:58
msgid "changes pending"
msgstr "modifications en attente"

#: templates/wizard.php:65
msgid "Turn on the search widget"
msgstr "Activez le widget de recherche"

#: templates/wizard.php:66
msgid "Paste the widget snippet from your Mibizum panel (Domains, JS code). If you connected through the wizard it may already be filled in."
msgstr "Collez le snippet du widget depuis votre panneau Mibizum (Domains, JS code). Si vous avez connecté via l'assistant, il est peut-être déjà rempli."

#: templates/wizard.php:70
msgid "Skip for now"
