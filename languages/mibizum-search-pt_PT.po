#: templates/wizard.php:34
msgid "Connect this store to Mibizum search"
msgstr "Ligue esta loja à pesquisa Mibizum"

#: templates/wizard.php:35
msgid "We will connect your store to Mibizum: index your catalog, power the search box and add the instant search widget."
msgstr "Vamos ligar a sua loja ao Mibizum: indexar o catálogo, potenciar a caixa de pesquisa e adicionar o widget de pesquisa instantânea."

#: templates/wizard.php:36
msgid "Nothing changes in your store until the connection is complete. You can stop any time."
msgstr "Nada muda na sua loja até a ligação estar concluída. Pode parar a qualquer momento."

#: templates/wizard.php:38
#: templates/wizard.php:60
msgid "Continue"
msgstr "Continuar"

#: templates/wizard.php:39
msgid "Later"
msgstr "Mais tarde"

#: templates/wizard.php:44
msgid "Sign in or create your Mibizum account"
msgstr "Inicie sessão ou crie a sua conta Mibizum"

#: templates/wizard.php:48
msgid "Could not load the Mibizum onboarding. You can configure the connection by hand instead."
msgstr "Não foi possível carregar o onboarding do Mibizum. Pode configurar a ligação manualmente."

#: templates/wizard.php:49
msgid "Configure manually"
msgstr "Configurar manualmente"

#: templates/wizard.php:55
msgid "Indexing your catalog"
msgstr "A indexar o seu catálogo"

#: templates/wizard.php:56
msgid "This runs in the background. You can keep working; you do not need to wait here."
msgstr "Isto é executado em segundo plano. Pode continuar a trabalhar; não precisa de esperar aqui."

#: templates/wizard.php:58
msgid "changes pending"
msgstr "alterações pendentes"

#: templates/wizard.php:65
msgid "Turn on the search widget"
msgstr "Ative o widget de pesquisa"

#: templates/wizard.php:66
msgid "Paste the widget snippet from your Mibizum panel (Domains, JS code). If you connected through the wizard it may already be filled in."
msgstr "Cole o snippet do widget do seu painel Mibizum (Domains, JS code). Se ligou através do assistente, pode já estar preenchido."

#: templates/wizard.php:70
msgid "Skip for now"
msgstr "Ignorar por agora"

#: templates/wizard.php:75
msgid "All set"
msgstr "Tudo pronto"

#: templates/wizard.php:76
msgid "Your store is connected to Mibizum. Your search box now uses the Mibizum engine."
msgstr "A sua loja está ligada ao Mibizum. A sua caixa de pesquisa usa agora o motor Mibizum."

#: templates/wizard.php:78
msgid "Done"
msgstr "Concluído"

